[sub_resource type="GDScript" id="GDScript_qvwlv"]
script/source = "extends Area2D

@onready var hp_bar = $\"../HPBar\"

func _on_body_entered(body):
	if body.name == \"Aurora\":
		Game.advance_to_level(\"Level3\")
"

